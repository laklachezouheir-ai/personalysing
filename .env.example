# Secret utilisé pour signer les sessions (obligatoire en production)
SESSION_SECRET=change_moi_avec_une_valeur_aleatoire_longue

# Port d'écoute du serveur
PORT=3000

# --- Intégration Etsy (Open API v3) ---
# À obtenir sur https://www.etsy.com/developers/your-apps
# Nécessite le tier "Commercial Access" pour gérer plusieurs boutiques
# (voir README.md, section "Connexion Etsy").
ETSY_API_KEY=
ETSY_SHARED_SECRET=
# URL de callback OAuth déclarée dans votre app Etsy, ex :
# http://localhost:3000/api/etsy/callback
ETSY_REDIRECT_URI=http://localhost:3000/api/etsy/callback

# --- Outils IA optionnels (chacun inactif tant que sa clé est vide) ---
# Optimiseur SEO — clé sur https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Générateur de mockups IA — clé sur https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Modèle utilisé (voir lib/replicateClient.js, à vérifier avant prod) :
# REPLICATE_MODEL=black-forest-labs/flux-kontext-pro

# Générateur de vidéos IA — clé sur https://dev.runwayml.com/
RUNWAY_API_KEY=
# Modèle utilisé (voir lib/runwayClient.js, à vérifier avant prod) :
# RUNWAY_MODEL=gen4_turbo

# Quotas quotidiens par vendeur (protection contre les dérapages de coût) :
# SEO_DAILY_LIMIT=30
# MOCKUP_DAILY_LIMIT=15
# VIDEO_DAILY_LIMIT=3

# --- Abonnement Pro (Stripe) — inactif tant que vide, outils IA ouverts ---
# Clé secrète sur https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# ID du prix récurrent de l'abonnement Pro (Produits > votre produit > Prix)
STRIPE_PRICE_ID=
# Secret de signature du endpoint webhook (Développeurs > Webhooks),
# à pointer vers https://votre-domaine/api/stripe/webhook, évènements :
# checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
# URL publique de l'app, utilisée pour les redirections Stripe Checkout
# (par défaut, déduite de la requête si absente)
# APP_BASE_URL=https://personalysing-xxxx.onrender.com
